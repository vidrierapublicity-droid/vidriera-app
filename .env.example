# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Clave secreta: SOLO en el servidor (Vercel / .env.local). Nunca la subas a Git
# ni la uses en componentes de cliente. Si tu proyecto es viejo, sirve la
# "service_role" legacy.
SUPABASE_SECRET_KEY=sb_secret_xxx

# URL pública de la app (en producción, tu dominio: https://vidriera.link)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Texto largo al azar para anonimizar visitantes en la analítica
ANALYTICS_SALT=cambia-esto-por-un-texto-largo-al-azar

# Solo para `npm run db:probar` contra una base LOCAL de pruebas
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
